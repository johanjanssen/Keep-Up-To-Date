FROM maven:3-eclipse-temurin-25 AS build
WORKDIR /build
COPY pom.xml .
COPY src src
RUN mvn package -DskipTests -q -Dmaven.compiler.source=25 -Dmaven.compiler.target=25

FROM eclipse-temurin:25-jdk
WORKDIR /app
COPY --from=build /build/target/benchmarks.jar benchmarks.jar
# Java 25 flags: compact headers (JEP 450) reduce per-object memory, preview features.
# Both Java 17 and 25 use G1GC (default) for fair memory comparison.
# Compact headers reduce each object header from 12→8 bytes (20-30% less heap for small objects).
ENTRYPOINT ["java", "--enable-preview", "-XX:+UseCompactObjectHeaders", \
    "-jar", "benchmarks.jar", "-rf", "json", "-rff", "/results/results.json"]

