<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>java-performance-benchmarks</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Java Performance Benchmarks</name>
    <description>JMH benchmarks demonstrating performance and memory improvements across Java versions</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <jmh.version>1.37</jmh.version>
    </properties>

    <dependencies>
        <!-- JMH runtime: the benchmark harness, result formatters and runner -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <!--
          JMH annotation processor: scans @Benchmark methods at compile time and
          generates synthetic benchmark classes + META-INF/BenchmarkList.
          Declared "provided" so it is on the compile classpath but NOT included
          in the final JAR (the generated classes are included instead).
          Also listed explicitly in annotationProcessorPaths below so it is
          picked up reliably on Java 21+ where implicit processor discovery
          from "provided" dependencies was deprecated and later disabled.
        -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              maven-compiler-plugin: explicit annotationProcessorPaths entry
              guarantees the JMH annotation processor runs on Java 17 through 25+.
              Without this, Java 21+ compiler warns about (and eventually disables)
              implicit processor discovery from "provided"-scoped dependencies.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
              maven-shade-plugin: packages everything into a single self-contained
              "fat/uber JAR" (benchmarks.jar) so the Docker image can run it with a
              plain "java -jar" without needing a classpath or separate dependency JARs.

              Three transformer types are required:
                1. ManifestResourceTransformer  – sets Main-Class so java -jar works.
                2. ServicesResourceTransformer  – merges META-INF/services/* files from
                   all JARs; without this, SPI lookup (e.g. JMH result formatters) breaks.
                3. AppendingTransformer (×2)    – appends rather than overwrites
                   META-INF/BenchmarkList and META-INF/CompilerHints; these files are
                   generated by the JMH annotation processor and must contain one line per
                   benchmark class. If shade just overwrites them only the last JAR's
                   entries survive and JMH throws "Unable to find the resource:
                   /META-INF/BenchmarkList" at runtime.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>benchmarks</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/BenchmarkList</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/CompilerHints</resource>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          "valhalla" profile — adds src/valhalla/java as an extra source root.

          That directory contains benchmark classes that use the `value` modifier
          (e.g. "value record Point(...)"), which only PARSES on a javac that has
          Project Valhalla's JEP 401 (Value Classes and Objects) preview support.
          Java 17/25 do not have this feature at all, so that source can only be
          compiled with the "enable preview" javac flag on a Valhalla-enabled
          Java 28 javac — activate this profile ONLY for the Java 28 build
          (see Dockerfile.java28).

          Without opting a class into `value class` / `value record`, the JVM
          never flattens it — plain `record Point(...)` stays a normal identity
          object on every JDK version, Valhalla included. Keeping the two variants
          in separate source roots is what lets the same repo build (a) the
          "just recompiled, nothing changed" baseline and (b) the real
          value-type benchmark, without breaking compilation on Java 17/25.
        -->
        <profile>
            <id>valhalla</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-valhalla-source</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/valhalla/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                      Full (not partial) override of maven-compiler-plugin's <configuration>
                      for this profile: Maven does not append list-typed parameters like
                      compilerArgs/annotationProcessorPaths across profile boundaries, it
                      replaces the whole block, so both need to be repeated here rather than
                      relying on "-Dmaven.compiler.compilerArgs=..." from the command line —
                      that property is NOT read by maven-compiler-plugin's compilerArgs (a
                      List<String> has no property expression to bind to), so passing the
                      "enable preview" flag that way silently does nothing. This
                      compilerArgs block is the only thing that actually enables
                      preview-feature parsing for "value record".
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.15.0</version>
                        <configuration>
                            <compilerArgs>
                                <arg>--enable-preview</arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>${jmh.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

