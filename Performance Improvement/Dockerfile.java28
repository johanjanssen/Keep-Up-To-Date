FROM maven:3-eclipse-temurin-21 AS maven
FROM openjdk:28-ea-trixie AS build
COPY --from=maven /usr/share/maven /usr/share/maven
ENV PATH="/usr/share/maven/bin:${PATH}"
WORKDIR /build
COPY pom.xml .
COPY src src
# -Pvalhalla adds src/valhalla/java (ValhallaValueBenchmark, which uses the
# `value record` preview syntax) to the build. That profile also carries its
# own maven-compiler-plugin <compilerArgs>--enable-preview</compilerArgs> —
# passing "-Dmaven.compiler.compilerArgs=--enable-preview" here would NOT
# work, since compilerArgs is a List<String> with no property expression to
# bind a single -D value to; it silently does nothing.
RUN mvn package -Pvalhalla -DskipTests -q \
      -Dmaven.compiler.source=28 -Dmaven.compiler.target=28

FROM openjdk:28-ea-trixie
WORKDIR /app
COPY --from=build /build/target/benchmarks.jar benchmarks.jar
# Java 28 EA with Valhalla value types enabled.
# Uses G1GC (default) same as Java 25 for fair comparison.
ENTRYPOINT ["java", "--enable-preview", "-XX:+UseCompactObjectHeaders", \
    "-jar", "benchmarks.jar", "-rf", "json", "-rff", "/results/results.json"]

