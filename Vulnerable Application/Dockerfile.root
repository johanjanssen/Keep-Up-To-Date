# ⚠️  INTENTIONALLY INSECURE — old base image, runs as ROOT, bloated with packages
#
# Demonstrates the WORST CASE:
#   • Old OS (Ubuntu 22.04 / glibc 2.35) — hundreds of known CVEs
#   • Runs as root — any RCE gives full system access
#   • Has policykit-1 installed — vulnerable to PwnKit (CVE-2021-4034)
#   • Has curl, wget, netcat — attacker can exfiltrate data, open reverse shells
#   • Has gcc — attacker can compile exploits on the spot
#
# Compare Trivy scans:  trivy image vuln-app:root  vs  trivy image vuln-app:safe

FROM eclipse-temurin:25-jdk AS build
WORKDIR /build
COPY mvnw mvnw.cmd ./
COPY .mvn .mvn
COPY pom.xml .
COPY src src
RUN chmod +x mvnw && ./mvnw package -DskipTests -q

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /build/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
