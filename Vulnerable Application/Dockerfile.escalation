# Non-root but with extra packages (for scan comparison)
FROM eclipse-temurin:25-jdk AS build
WORKDIR /build
COPY mvnw mvnw.cmd ./
COPY .mvn .mvn
COPY pom.xml .
COPY src src
RUN chmod +x mvnw && ./mvnw package -DskipTests -q

FROM eclipse-temurin:25-jre
WORKDIR /app
RUN chown -R ubuntu:ubuntu /app
COPY --from=build --chown=ubuntu:ubuntu /build/target/*.jar app.jar
USER ubuntu
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
