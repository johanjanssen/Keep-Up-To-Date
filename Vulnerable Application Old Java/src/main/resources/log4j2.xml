<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log4j 2.14.1 configuration for the vulnerable demo app.

    This file ensures log4j-core 2.14.1 is used as the active logging implementation
    for any Logger obtained via LogManager.getLogger() — keeping the Log4Shell
    (CVE-2021-44228) JNDI lookup path alive for demonstration purposes.

    Spring Boot's own internal logging still routes through SLF4J → Logback.
    Only the controller's explicit Log4j2 loggers are affected here.
-->
<Configuration status="WARN" monitorInterval="0">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <!-- Match Spring Boot's default Logback format so log lines look consistent -->
            <PatternLayout pattern="%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}{UTC}  %-5p 1 --- [%15.15t] %-40.40c{1} : %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.example" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>

