# Runtime base: gcr.io/distroless/base-debian12  (Debian 12 Bookworm)
# jlink JRE is glibc-linked (Temurin) → needs glibc → distroless/base, not static

# ── Stage 1: Maven build ──────────────────────────────────────
FROM eclipse-temurin:25-jdk AS builder
WORKDIR /workspace

COPY mvnw mvnw
COPY .mvn .mvn
COPY pom.xml pom.xml
RUN chmod +x mvnw && ./mvnw dependency:go-offline -q --no-transfer-progress 2>/dev/null || true

COPY src src
RUN ./mvnw package -DskipTests --no-transfer-progress

# ── Stage 2: jlink – full JRE (all modules except jlink/jpackage) ─
FROM eclipse-temurin:25-jdk AS jre-builder

RUN MODULES=$(java --list-modules | sed 's/@.*//' | \
        grep -vE '^jdk\.(jlink|jpackage)$' | \
        paste -sd ',') && \
    echo "Modules: ${MODULES}" && \
    jlink \
        --add-modules "${MODULES}" \
        --strip-debug \
        --compress=zip-6 \
        --no-header-files \
        --no-man-pages \
        --output /jre-full

# ── Stage 3: distroless runtime ───────────────────────────────
FROM gcr.io/distroless/base-debian12

ENV JAVA_HOME=/jre
ENV PATH="/jre/bin:${PATH}"

COPY --from=jre-builder /jre-full /jre
COPY --from=builder /workspace/target/HelloConference-0.0.1-SNAPSHOT.jar /app/app.jar

WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["/jre/bin/java", "-jar", "app.jar"]
