license": "The Apache Software License, Version 2.0: http:\/\/www.apache.org\/licenses\/LICENSE-2.0.txt","id5": "pkg:maven\/com.fasterxml.jackson.core\/jackson-databind@2.13.4.1","vid6": "cpe:2.3:a:fasterxml:jackson-core:2.13.4.1:*:*:*:*:*:*:*","vid7": "cpe:2.3:a:fasterxml:jackson-databind:2.13.4.1:*:*:*:*:*:*:*","vid8": "cpe:2.3:a:fasterxml:jackson-modules-java8:2.13.4.1:*:*:*:*:*:*:*"}},{"description": {"text": "General data-binding functionality for Jackson: works on core streaming API"},"location": {"uri": "file://\/home\/runner\/.m2\/repository\/tools\/jackson\/core\/jackson-databind\/3.1.4\/jackson-databind-3.1.4.jar"},"hashes": {"md5": "177c7c83c06cd3fd971fc1ec819bbe9f","sha1": "c7be3c757289893a791b2a4967ec09d1a8b6c576","sha256": "14034bfdf392b6ebec1b4bb6c1de29d604f0aa97251259a19d5f19af8719bb20"},"properties": {"license": "The Apache Software License, Version 2.0: https:\/\/www.apache.org\/licenses\/LICENSE-2.0.txt","id6": "pkg:maven\/tools.jackson.core\/jackson-databind@3.1.4","vid9": "cpe:2.3:a:fasterxml:jackson-core:3.1.4:*:*:*:*:*:*:*","vid10": "cpe:2.3:a:fasterxml:jackson-databind:3.1.4:*:*:*:*:*:*:*"}},{"description": {"text": "Jakarta Annotations API"},"location": {"uri": "file://\/home\/runner\/.m2\/repository\/jakarta\/annotation\/jakarta.annotation-api\/3.0.0\/jakarta.annotation-api-3.0.0.jar"},"hashes": {"md5": "7faffaab962918da4cf5ddfd76609dd2","sha1": "54f928fadec906a99d558536756d171917b9d936","sha256": "b01f55552284cfb149411e64eabca75e942d26d2e1786b32914250e4330afaa2"},"properties": {"license": "EPL 2.0: https:\/\/www.eclipse.org\/legal\/epl-2.0\nGPL2 w\/ CPE: https:\/\/www.gnu.org\/software\/classpath\/license.html","id7": "pkg:maven\/jakarta.annotation\/jakarta.annotation-api@3.0.0"}},{"description": {"text": "An artifact of well-named and well-specified annotations to power static analysis checks"},"location": {"uri": "file://\/home\/runner\/.m2\/repository\/org\/jspecify\/jspecify\/1.0.0\/jspecify-1.0.0.jar"},"hashes": {"md5": "9133aba420d0c