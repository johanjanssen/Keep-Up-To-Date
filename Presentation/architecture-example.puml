@startuml
!theme bluegray
!pragma layout smetana
skinparam backgroundColor transparent
skinparam roundCorner 12
skinparam rectangle {
    BorderColor #586e75
    FontStyle bold
}

rectangle "Docker Image / Virtual machine\n<size:11><i>debian</i></size>" as vm #ECE8F7 {
    rectangle "OS packages including runtime\n<size:11><i>openssl, JVM (Eclipse Temurin)</i></size>" as os #FDEBD9 {
        rectangle "Application" as app #DCEEFB {
            rectangle "Application dependencies\n<size:11><i>Spring Boot, Log4j</i></size>" as deps #E6F4D9 {
            }
        }
    }
}

@enduml
